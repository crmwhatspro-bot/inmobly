rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /leads/{lead} {
      allow create: if request.resource.data.keys().hasAll(['name','email','createdAt']);
      allow read, update, delete: if request.auth != null;
    }

    match /leads_imovel/{lead} {
      allow create: if request.resource.data.keys().hasAll(['name','email','createdAt']);
      allow read, update, delete: if request.auth != null;
    }

    match /stats/{stat} {
      allow write: if true;
      allow read: if request.auth != null;
    }

    // Catálogo de imóveis — leitura pública, escrita somente do admin
    match /imoveis/{imovel} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == '{{ADMIN_EMAIL}}';

      match /fotos/{foto} {
        allow read: if true;
        allow write: if request.auth != null
                     && request.auth.token.email == '{{ADMIN_EMAIL}}';
      }
    }

  }
}
